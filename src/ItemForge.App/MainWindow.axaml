<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ItemForge.App.MainWindow"
        Width="1200" Height="760"
        MinWidth="820" MinHeight="520"
        Title="Helbreath Item Forge"
        Background="{DynamicResource HbaEditorBrush}"
        TransparencyLevelHint="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Grid RowDefinitions="34,*,24">

    <!-- Custom title bar: app mark, menus, centered card name, window controls (Workbench layout). -->
    <Grid Grid.Row="0" Background="{DynamicResource HbaActivityBrush}" ColumnDefinitions="48,Auto,*,Auto">
      <Image Grid.Column="0" Name="AppIcon" Width="17" Height="17" />
      <Menu Grid.Column="1" VerticalAlignment="Stretch" Background="Transparent">
        <MenuItem Header="File">
          <MenuItem Header="New Card..." Click="OnNewCard" InputGesture="Ctrl+N" />
          <MenuItem Header="Save Card" Click="OnSave" InputGesture="Ctrl+S" />
          <MenuItem Header="Close Card" Click="OnCloseCardMenu" />
          <Separator />
          <MenuItem Header="Open Workspace..." Click="OnOpenWorkspace" />
          <MenuItem Header="Reveal Workspace Folder" Click="OnRevealWorkspace" />
          <Separator />
          <MenuItem Header="Exit" Click="OnClose" />
        </MenuItem>
        <MenuItem Header="View">
          <MenuItem Header="Theme">
            <MenuItem Header="System" Click="OnThemeSystem" />
            <MenuItem Header="Light" Click="OnThemeLight" />
            <MenuItem Header="Dark" Click="OnThemeDark" />
          </MenuItem>
          <Separator />
          <MenuItem Header="Card Gallery" Click="OnShowGallery" />
          <MenuItem Header="Refresh Cards" Click="OnRefresh" InputGesture="F5" />
        </MenuItem>
        <MenuItem Header="Tools">
          <MenuItem Header="Claude Code Integration">
            <MenuItem Name="IntegrationOffItem" Header="Off" Click="OnIntegrationOff" />
            <MenuItem Name="IntegrationObserveItem" Header="Observe (read-only)" Click="OnIntegrationObserve" />
            <MenuItem Name="IntegrationFullItem" Header="Full (read/write)" Click="OnIntegrationFull" />
            <Separator />
            <MenuItem Header="Copy connect command" Click="OnCopyConnectCommand" />
            <MenuItem Header="Copy .mcp.json config" Click="OnCopyMcpJson" />
            <MenuItem Header="Copy server URL" Click="OnCopyServerUrl" />
            <MenuItem Header="Copy bearer token" Click="OnCopyToken" />
          </MenuItem>
        </MenuItem>
      </Menu>
      <Border Grid.Column="2" Name="DragArea" Background="Transparent"
              PointerPressed="OnTitleBarPressed" DoubleTapped="OnTitleBarDoubleTapped">
        <TextBlock Name="TitleText" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource HbaMutedBrush}" />
      </Border>
      <StackPanel Grid.Column="3" Orientation="Horizontal">
        <Button Classes="caption" Click="OnMinimize">
          <Path Stroke="{DynamicResource HbaMetalBrush}" StrokeThickness="1" Data="M0,5 H10" />
        </Button>
        <Button Classes="caption" Name="MaxButton" Click="OnMaximizeRestore">
          <Path Stroke="{DynamicResource HbaMetalBrush}" StrokeThickness="1" Data="M0,0 H10 V10 H0 Z" />
        </Button>
        <Button Classes="caption close" Click="OnClose">
          <Path Stroke="{DynamicResource HbaMetalBrush}" StrokeThickness="1" Data="M0,0 L10,10 M0,10 L10,0" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Body: activity bar | side bar | splitter | editor -->
    <Grid Grid.Row="1" ColumnDefinitions="48,258,4,*">

      <!-- Activity bar -->
      <Grid Grid.Column="0" Background="{DynamicResource HbaActivityBrush}" RowDefinitions="*,Auto">
        <StackPanel Grid.Row="0">
          <Button Classes="activity active" Name="CardsActivity" Click="OnShowGallery" ToolTip.Tip="Cards">
            <Path Stroke="{DynamicResource HbaMetalBrush}" StrokeThickness="1.4"
                  Data="M2,2 H7 V7 H2 Z M9,2 H14 V7 H9 Z M2,9 H7 V14 H2 Z M9,9 H14 V14 H9 Z" />
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button Classes="activity" Name="ThemeButton" Click="OnThemeToggle" ToolTip.Tip="Toggle light / dark">
            <Path Fill="{DynamicResource HbaMetalBrush}" Data="M9,2 A6,6 0 1 0 9,14 A4.5,4.5 0 1 1 9,2 Z" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Side bar (card list) -->
      <Border Grid.Column="1" Background="{DynamicResource HbaSideBarBrush}"
              BorderBrush="{DynamicResource HbaBorderBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="34,Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Name="SideHeader" Text="CARDS" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource HbaMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button Grid.Column="1" Classes="flat" Click="OnNewCard" ToolTip.Tip="New card" Margin="0,0,6,0" Padding="7,5">
              <Path Stroke="{DynamicResource HbaMetalBrush}" StrokeThickness="1.3" Data="M5,0 V10 M0,5 H10" />
            </Button>
          </Grid>
          <TextBox Grid.Row="1" Name="FilterBox" Watermark="Filter cards" FontSize="12" Margin="8,0,8,6" />
          <ListBox Grid.Row="2" Name="CardList" Classes="cards" Background="Transparent" Padding="0,2">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Name}" FontSize="12" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource HbaMutedBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="2" />

      <!-- Editor -->
      <Grid Grid.Column="3" Background="{DynamicResource HbaEditorBrush}" RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Name="TabStrip" Background="{DynamicResource HbaTitleBarBrush}"
                BorderBrush="{DynamicResource HbaBorderBrush}" BorderThickness="0,0,0,1"
                Height="35" IsVisible="False">
          <StackPanel Name="Tabs" Orientation="Horizontal" />
        </Border>

        <Border Grid.Row="1" Name="Breadcrumb" Background="{DynamicResource HbaEditorBrush}"
                BorderBrush="{DynamicResource HbaBorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,5" IsVisible="False">
          <TextBlock Name="BreadcrumbText" FontSize="11.5" VerticalAlignment="Center"
                     Foreground="{DynamicResource HbaMutedBrush}" />
        </Border>

        <ContentControl Grid.Row="2" Name="ViewerHost" />
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="{DynamicResource HbaTitleBarBrush}"
            BorderBrush="{DynamicResource HbaBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,0">
        <TextBlock Grid.Column="0" Name="StatusText" FontSize="11.5" VerticalAlignment="Center"
                   Foreground="{DynamicResource HbaMutedBrush}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Name="IntegrationStatus" FontSize="11.5" VerticalAlignment="Center"
                   Foreground="{DynamicResource HbaAccentBrush}" Margin="0,0,14,0" IsVisible="False" />
        <TextBlock Grid.Column="2" Name="StatusRight" FontSize="11.5" VerticalAlignment="Center"
                   Foreground="{DynamicResource HbaMutedBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
